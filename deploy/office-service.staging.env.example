NODE_ENV=production
PORT=5003
DB_HOST=mysql
DB_PORT=3306
DB_USER=phongkham
DB_PASSWORD=replace-with-mysql-password
DB_NAME=phong_kham
UPLOAD_DIR=/backend/uploads/office
# Phải giống hệt OFFICE_INTERNAL_TOKEN của backend
OFFICE_INTERNAL_TOKEN=replace-with-long-random-string
# Phải giống hệt JWT_SECRET của backend (dùng để xác thực socket)
JWT_SECRET=replace-with-backend-jwt-secret
# Domain frontend được phép kết nối socket (phân tách bằng dấu phẩy)
CLIENT_URL=https://staging.example.com
