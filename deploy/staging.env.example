DOMAIN=staging.example.com
IMAGE_PREFIX=ghcr.io/your-github-user/phongkham
IMAGE_TAG=latest

MYSQL_DATABASE=phong_kham
MYSQL_USER=phongkham
MYSQL_PASSWORD=replace-with-a-long-random-value
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-value

JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace-with-another-long-random-value
JWT_REFRESH_EXPIRES_IN=30d

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=staging@example.com
MAIL_PASS=replace-with-an-app-password
MAIL_FROM=staging@example.com
OTP_EXPIRES_MINUTES=10

GEMINI_API_KEY=replace-if-ai-is-enabled
PAYOS_CLIENT_ID=replace-if-payments-are-enabled
PAYOS_API_KEY=replace-if-payments-are-enabled
PAYOS_CHECKSUM_KEY=replace-if-payments-are-enabled
