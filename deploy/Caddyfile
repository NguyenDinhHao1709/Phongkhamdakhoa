{$DOMAIN} {
    encode gzip

    @websocket path /socket.io/*
    reverse_proxy @websocket backend:5000 {
        transport http {
            versions 1.1
        }
    }

    handle /api/* {
        reverse_proxy backend:5000
    }

    handle /uploads/* {
        reverse_proxy backend:5000
    }

    handle {
        reverse_proxy frontend:80
    }
}
