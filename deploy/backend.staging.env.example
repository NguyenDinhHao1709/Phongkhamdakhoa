NODE_ENV=production
PORT=5000
DB_HOST=mysql
DB_PORT=3306
DB_USER=phongkham
DB_PASSWORD=replace-with-mysql-password
DB_NAME=phong_kham
REDIS_HOST=redis
REDIS_PORT=6379
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50
CLIENT_URL=https://staging.example.com
AI_SERVICE_URL=http://ai-service:5002
AI_INTERNAL_KEY=replace-with-same-random-secret-on-backend-and-ai-service
OFFICE_SERVICE_URL=http://office-service:5003
PYTHON_ML_URL=http://python-ml:5001
DB_LOGGING=false
DB_POOL_LIMIT=20
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace-with-another-long-random-value
JWT_REFRESH_EXPIRES_IN=30d
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=staging@example.com
MAIL_PASS=replace-with-an-app-password
MAIL_FROM=staging@example.com
OTP_EXPIRES_MINUTES=10
PAYOS_CLIENT_ID=replace-if-payments-are-enabled
PAYOS_API_KEY=replace-if-payments-are-enabled
PAYOS_CHECKSUM_KEY=replace-if-payments-are-enabled
