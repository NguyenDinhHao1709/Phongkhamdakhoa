<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_TuVanTrucTuyen" targetNamespace="http://phongkham.local/bpmn">
  <bpmn:collaboration id="Collab_TuVanTrucTuyen">
    <bpmn:participant id="Pool_TuVanTrucTuyen" name="Tư vấn khám bệnh trực tuyến (video call)" processRef="Process_TuVanTrucTuyen" />
  </bpmn:collaboration>
  <bpmn:process id="Process_TuVanTrucTuyen" isExecutable="false">
    <bpmn:laneSet id="LaneSet_TuVanTrucTuyen">
      <bpmn:lane id="Lane_BN" name="Bệnh nhân">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BnVao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndOk</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HT" name="Hệ thống">
        <bpmn:flowNodeRef>MoPhong</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GhiVao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwDienRa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TaoHs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwBs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwBn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VangMat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndVang</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BS" name="Bác sĩ">
        <bpmn:flowNodeRef>BsVao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TuVan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TN" name="Thu ngân">
        <bpmn:flowNodeRef>HoanBs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>XacMinh</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HoanPhi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndHoan</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Lịch trực tuyến đã đóng 100% phí">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="MoPhong" name="Mở phòng gọi từ 15 phút trước giờ hẹn">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="BnVao" name="Vào phòng gọi (kèm token)">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="BsVao" name="Vào phòng gọi (kèm token)">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="GhiVao" name="Ghi thời điểm vào phòng của từng bên">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GwDienRa" name="Ca được kết luận trong ngày hẹn?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="TuVan" name="Tư vấn video, nhập chẩn đoán &amp; lời khuyên">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="TaoHs" name="Lưu hồ sơ bệnh án HSxxxxxx, lịch hẹn hoàn thành">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndOk" name="Tư vấn hoàn tất">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GwBs" name="Bác sĩ đã vào phòng?">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="HoanBs" name="Hủy ca, tạo yêu cầu &quot;chờ hoàn&quot; phí">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GwBn" name="Bệnh nhân đã vào phòng?">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="VangMat" name="Đánh dấu vắng mặt, không hoàn phí">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndVang" name="Ca kết thúc (bệnh nhân vắng)">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="XacMinh" name="Xác minh nguyên nhân, quyết định hoàn">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="HoanPhi" name="Hoàn phí cho bệnh nhân">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndHoan" name="Đã xử lý hoàn phí">
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" name="" sourceRef="Start" targetRef="MoPhong" />
    <bpmn:sequenceFlow id="Flow_2" name="" sourceRef="MoPhong" targetRef="BnVao" />
    <bpmn:sequenceFlow id="Flow_3" name="" sourceRef="MoPhong" targetRef="BsVao" />
    <bpmn:sequenceFlow id="Flow_4" name="" sourceRef="BnVao" targetRef="GhiVao" />
    <bpmn:sequenceFlow id="Flow_5" name="" sourceRef="BsVao" targetRef="GhiVao" />
    <bpmn:sequenceFlow id="Flow_6" name="" sourceRef="GhiVao" targetRef="GwDienRa" />
    <bpmn:sequenceFlow id="Flow_7" name="Có" sourceRef="GwDienRa" targetRef="TuVan" />
    <bpmn:sequenceFlow id="Flow_8" name="Không (hết ngày)" sourceRef="GwDienRa" targetRef="GwBs" />
    <bpmn:sequenceFlow id="Flow_9" name="" sourceRef="TuVan" targetRef="TaoHs" />
    <bpmn:sequenceFlow id="Flow_10" name="" sourceRef="TaoHs" targetRef="EndOk" />
    <bpmn:sequenceFlow id="Flow_11" name="Không" sourceRef="GwBs" targetRef="HoanBs" />
    <bpmn:sequenceFlow id="Flow_12" name="Có" sourceRef="GwBs" targetRef="GwBn" />
    <bpmn:sequenceFlow id="Flow_13" name="Không" sourceRef="GwBn" targetRef="VangMat" />
    <bpmn:sequenceFlow id="Flow_14" name="Có (chưa kết luận)" sourceRef="GwBn" targetRef="XacMinh" />
    <bpmn:sequenceFlow id="Flow_15" name="" sourceRef="VangMat" targetRef="EndVang" />
    <bpmn:sequenceFlow id="Flow_16" name="Nếu hoàn" sourceRef="XacMinh" targetRef="HoanPhi" />
    <bpmn:sequenceFlow id="Flow_17" name="" sourceRef="HoanBs" targetRef="HoanPhi" />
    <bpmn:sequenceFlow id="Flow_18" name="" sourceRef="HoanPhi" targetRef="EndHoan" />
  </bpmn:process>
