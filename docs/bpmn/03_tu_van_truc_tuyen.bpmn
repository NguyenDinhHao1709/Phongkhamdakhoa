      <bpmndi:BPMNShape id="GwKL_di" bpmnElement="GwKL" isMarkerVisible="true"><dc:Bounds x="1430" y="447.5" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1395" y="416.5" width="120" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TaoHs_di" bpmnElement="TaoHs"><dc:Bounds x="1550" y="190" width="160" height="80" /></bpmndi:BPMNShape>
