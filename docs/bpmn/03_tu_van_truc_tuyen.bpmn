      <bpmndi:BPMNEdge id="Flow_18_di" bpmnElement="Flow_18"><di:waypoint x="2410" y="350" /><di:waypoint x="2680" y="350" /><di:waypoint x="2680" y="615" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_19_di" bpmnElement="Flow_19"><di:waypoint x="2410" y="655" /><di:waypoint x="2480" y="655" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_20_di" bpmnElement="Flow_20"><di:waypoint x="2530" y="655" /><di:waypoint x="2600" y="655" /><bpmndi:BPMNLabel><dc:Bounds x="2536" y="625" width="60" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_21_di" bpmnElement="Flow_21"><di:waypoint x="2505" y="680" /><di:waypoint x="2505" y="697" /><bpmndi:BPMNLabel><dc:Bounds x="2511" y="684" width="120" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_22_di" bpmnElement="Flow_22"><di:waypoint x="2760" y="655" /><di:waypoint x="2837" y="655" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
