      <bpmndi:BPMNShape id="GwCase_di" bpmnElement="GwCase" isMarkerVisible="true"><dc:Bounds x="1955" y="265" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1831" y="277" width="120" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="VangMat_di" bpmnElement="VangMat"><dc:Bounds x="2250" y="190" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndVang_di" bpmnElement="EndVang"><dc:Bounds x="2487" y="212" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2445" y="252" width="120" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="HoanYC_di" bpmnElement="HoanYC"><dc:Bounds x="2250" y="310" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="XacMinh_di" bpmnElement="XacMinh"><dc:Bounds x="2250" y="615" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GwXm_di" bpmnElement="GwXm" isMarkerVisible="true"><dc:Bounds x="2480" y="630" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="2445" y="599" width="120" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndKhongHoan_di" bpmnElement="EndKhongHoan"><dc:Bounds x="2487" y="697" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2363" y="702" width="120" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="HoanPhi_di" bpmnElement="HoanPhi"><dc:Bounds x="2600" y="615" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndHoan_di" bpmnElement="EndHoan"><dc:Bounds x="2837" y="637" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2795" y="677" width="120" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="248" y="290" /><di:waypoint x="325" y="290" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="485" y="290" /><di:waypoint x="555" y="290" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="580" y="265" /><di:waypoint x="580" y="107.5" /><di:waypoint x="675" y="107.5" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="580" y="315" /><di:waypoint x="580" y="472.5" /><di:waypoint x="675" y="472.5" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="835" y="107.5" /><di:waypoint x="930" y="107.5" /><di:waypoint x="930" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="835" y="472.5" /><di:waypoint x="930" y="472.5" /><di:waypoint x="930" y="330" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="1010" y="290" /><di:waypoint x="1080" y="290" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="1105" y="315" /><di:waypoint x="1105" y="472.5" /><di:waypoint x="1200" y="472.5" /><bpmndi:BPMNLabel><dc:Bounds x="1111" y="319" width="120" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="1130" y="290" /><di:waypoint x="1955" y="290" /><bpmndi:BPMNLabel><dc:Bounds x="1136" y="260" width="220" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="1360" y="472.5" /><di:waypoint x="1430" y="472.5" /></bpmndi:BPMNEdge>
