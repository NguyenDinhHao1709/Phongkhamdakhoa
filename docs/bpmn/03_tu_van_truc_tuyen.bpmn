<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_TuVan" targetNamespace="http://phongkham.local/bpmn">
  <bpmn:collaboration id="Collab_TuVan">
    <bpmn:participant id="Pool_TuVan" name="Quy trình tư vấn trực tuyến (video call)" processRef="Process_TuVan" />
  </bpmn:collaboration>
  <bpmn:process id="Process_TuVan" isExecutable="false">
    <bpmn:laneSet id="LaneSet_TuVan">
      <bpmn:lane id="Lane_BN" name="Bệnh nhân">
        <bpmn:flowNodeRef>BnVao</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HT" name="Hệ thống">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MoPhong</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GhiVao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwGap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TaoHs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwCase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VangMat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndVang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HoanYC</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BS" name="Bác sĩ">
        <bpmn:flowNodeRef>BsVao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TuVan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwKL</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TN" name="Thu ngân">
        <bpmn:flowNodeRef>XacMinh</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwXm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndKhongHoan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HoanPhi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndHoan</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Lịch trực tuyến đã đóng 100% phí">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="MoPhong" name="Mở phòng gọi từ 15 phút trước giờ hẹn">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GwSplit" name="">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="BnVao" name="Vào phòng gọi (đăng nhập, kèm token)">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="BsVao" name="Vào phòng gọi (bác sĩ phụ trách, kèm token)">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="GhiVao" name="Ghi lúc từng bên vào phòng và lúc hai bên gặp nhau">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GwGap" name="Hai bên gặp nhau trước khi phòng đóng?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="TuVan" name="Tư vấn video, chat / gửi tệp, nhập chẩn đoán &amp; lời khuyên">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GwKL" name="Kết luận trong ngày hẹn?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="TaoHs" name="Lưu hồ sơ bệnh án HSxxxxxx, lịch hoàn thành">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndOk" name="Tư vấn hoàn tất">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GwCase" name="Ai đã vào phòng?">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="VangMat" name="Lịch → vắng mặt, không hoàn phí">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndVang" name="Ca kết thúc (bệnh nhân vắng)">
      <bpmn:incoming>Flow_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="HoanYC" name="Hủy ca, tạo yêu cầu &quot;chờ hoàn&quot; phí">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="XacMinh" name="Xác minh nguyên nhân">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GwXm" name="Hoàn phí?">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndKhongHoan" name="Không hoàn phí">
      <bpmn:incoming>Flow_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="HoanPhi" name="Hoàn phí cho bệnh nhân">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndHoan" name="Đã hoàn phí">
      <bpmn:incoming>Flow_22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" name="" sourceRef="Start" targetRef="MoPhong" />
    <bpmn:sequenceFlow id="Flow_2" name="" sourceRef="MoPhong" targetRef="GwSplit" />
    <bpmn:sequenceFlow id="Flow_3" name="" sourceRef="GwSplit" targetRef="BnVao" />
    <bpmn:sequenceFlow id="Flow_4" name="" sourceRef="GwSplit" targetRef="BsVao" />
    <bpmn:sequenceFlow id="Flow_5" name="" sourceRef="BnVao" targetRef="GhiVao" />
    <bpmn:sequenceFlow id="Flow_6" name="" sourceRef="BsVao" targetRef="GhiVao" />
    <bpmn:sequenceFlow id="Flow_7" name="" sourceRef="GhiVao" targetRef="GwGap" />
    <bpmn:sequenceFlow id="Flow_8" name="Có" sourceRef="GwGap" targetRef="TuVan" />
    <bpmn:sequenceFlow id="Flow_9" name="Không (phòng đóng: giờ hẹn + 60 phút)" sourceRef="GwGap" targetRef="GwCase" />
    <bpmn:sequenceFlow id="Flow_10" name="" sourceRef="TuVan" targetRef="GwKL" />
    <bpmn:sequenceFlow id="Flow_11" name="Có" sourceRef="GwKL" targetRef="TaoHs" />
    <bpmn:sequenceFlow id="Flow_12" name="Không (hết ngày hẹn)" sourceRef="GwKL" targetRef="XacMinh" />
    <bpmn:sequenceFlow id="Flow_13" name="" sourceRef="TaoHs" targetRef="EndOk" />
    <bpmn:sequenceFlow id="Flow_14" name="Chỉ bác sĩ vào" sourceRef="GwCase" targetRef="VangMat" />
    <bpmn:sequenceFlow id="Flow_15" name="Bác sĩ không vào" sourceRef="GwCase" targetRef="HoanYC" />
    <bpmn:sequenceFlow id="Flow_16" name="Cả hai vào nhưng lệch giờ" sourceRef="GwCase" targetRef="XacMinh" />
    <bpmn:sequenceFlow id="Flow_17" name="" sourceRef="VangMat" targetRef="EndVang" />
    <bpmn:sequenceFlow id="Flow_18" name="" sourceRef="HoanYC" targetRef="HoanPhi" />
    <bpmn:sequenceFlow id="Flow_19" name="" sourceRef="XacMinh" targetRef="GwXm" />
    <bpmn:sequenceFlow id="Flow_20" name="Có" sourceRef="GwXm" targetRef="HoanPhi" />
    <bpmn:sequenceFlow id="Flow_21" name="Không" sourceRef="GwXm" targetRef="EndKhongHoan" />
    <bpmn:sequenceFlow id="Flow_22" name="" sourceRef="HoanPhi" targetRef="EndHoan" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_TuVan">
    <bpmndi:BPMNPlane id="Plane_TuVan" bpmnElement="Collab_TuVan">
      <bpmndi:BPMNShape id="Pool_TuVan_di" bpmnElement="Pool_TuVan" isHorizontal="true"><dc:Bounds x="90" y="40" width="2895" height="730" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_BN_di" bpmnElement="Lane_BN" isHorizontal="true"><dc:Bounds x="120" y="40" width="2865" height="135" /></bpmndi:BPMNShape>
