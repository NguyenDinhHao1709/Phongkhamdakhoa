<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_KhamTrucTiep" targetNamespace="http://phongkham.local/bpmn">
  <bpmn:collaboration id="Collab_KhamTrucTiep">
    <bpmn:participant id="Pool_KhamTrucTiep" name="Quy trình khám bệnh ngoại trú trực tiếp" processRef="Process_KhamTrucTiep" />
  </bpmn:collaboration>
  <bpmn:process id="Process_KhamTrucTiep" isExecutable="false">
    <bpmn:laneSet id="LaneSet_KhamTrucTiep">
      <bpmn:lane id="Lane_BN" name="Bệnh nhân">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_LT" name="Lễ tân / Kiosk">
        <bpmn:flowNodeRef>GwHen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CheckIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TaoLuot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CapSo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HT" name="Hệ thống">
        <bpmn:flowNodeRef>GwCapCuu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TinhTU</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwConThu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>XepHang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>QuaLuot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwLan3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndVang</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TN" name="Thu ngân">
        <bpmn:flowNodeRef>ThuTU</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TimerTU</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HuyLuot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndHuy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>QuyetToan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwThuHoan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ThuThem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HoanDu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwGop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwThuoc</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BS" name="Bác sĩ">
        <bpmn:flowNodeRef>GoiKham</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwCoMat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Kham</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwCls</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>KetLuan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_KTV" name="Kỹ thuật viên">
        <bpmn:flowNodeRef>Cls</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DS" name="Dược sĩ">
        <bpmn:flowNodeRef>CapThuoc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Bệnh nhân đến phòng khám">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="GwHen" name="Có lịch hẹn hôm nay?">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="CheckIn" name="Check-in lịch hẹn (quầy / kiosk)">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="TaoLuot" name="Tìm / tạo hồ sơ, chọn chuyên khoa, bác sĩ, đối tượng ưu tiên">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="CapSo" name="Tạo lượt tiếp nhận, cấp số thứ tự A/B">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GwCapCuu" name="Cấp cứu?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="TinhTU" name="Lập phiếu tạm ứng TU = phí khám − BHYT − cọc">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GwConThu" name="Còn phải thu?">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ThuTU" name="Thu tạm ứng phí khám">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="TimerTU" name="Quá giờ hẹn 15 phút" attachedToRef="ThuTU" cancelActivity="true">
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_TimerTU"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">PT15M</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="HuyLuot" name="Hủy lượt; lịch hẹn → vắng mặt">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndHuy" name="Lượt bị hủy">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="XepHang" name="Xếp hàng đợi theo ưu tiên &amp; giờ hẹn">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="GoiKham" name="Gọi bệnh nhân vào phòng">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GwCoMat" name="Có mặt?">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="QuaLuot" name="Qua lượt (xếp cuối hàng)">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GwLan3" name="Lần thứ 3?">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndVang" name="Hủy lượt (vắng mặt)">
      <bpmn:incoming>Flow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Kham" name="Khám lâm sàng, sinh hiệu, chẩn đoán sơ bộ">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GwCls" name="Cần cận lâm sàng?">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Cls" name="Lấy mẫu / thực hiện CLS, nhập kết quả">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="KetLuan" name="Chẩn đoán ICD-10, kê đơn, kết thúc khám">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="QuyetToan" name="Quyết toán: tổng chi phí − BHYT − tạm ứng">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GwThuHoan" name="Thu thêm / hoàn?">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ThuThem" name="Thu thêm phần còn thiếu">
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="HoanDu" name="Hoàn tạm ứng dư cho bệnh nhân">
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GwGop" name="">
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:incoming>Flow_32</bpmn:incoming>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GwThuoc" name="Có đơn thuốc?">
      <bpmn:incoming>Flow_33</bpmn:incoming>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
      <bpmn:outgoing>Flow_35</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="CapThuoc" name="Cấp phát thuốc theo đơn">
      <bpmn:incoming>Flow_34</bpmn:incoming>
      <bpmn:outgoing>Flow_36</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End" name="Hoàn thành lượt khám">
      <bpmn:incoming>Flow_35</bpmn:incoming>
      <bpmn:incoming>Flow_36</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" name="" sourceRef="Start" targetRef="GwHen" />
    <bpmn:sequenceFlow id="Flow_2" name="Có" sourceRef="GwHen" targetRef="CheckIn" />
    <bpmn:sequenceFlow id="Flow_3" name="Không" sourceRef="GwHen" targetRef="TaoLuot" />
    <bpmn:sequenceFlow id="Flow_4" name="" sourceRef="CheckIn" targetRef="CapSo" />
    <bpmn:sequenceFlow id="Flow_5" name="" sourceRef="TaoLuot" targetRef="CapSo" />
    <bpmn:sequenceFlow id="Flow_6" name="" sourceRef="CapSo" targetRef="GwCapCuu" />
    <bpmn:sequenceFlow id="Flow_7" name="Không" sourceRef="GwCapCuu" targetRef="TinhTU" />
    <bpmn:sequenceFlow id="Flow_8" name="Có" sourceRef="GwCapCuu" targetRef="XepHang" />
    <bpmn:sequenceFlow id="Flow_9" name="" sourceRef="TinhTU" targetRef="GwConThu" />
    <bpmn:sequenceFlow id="Flow_10" name="Có" sourceRef="GwConThu" targetRef="ThuTU" />
    <bpmn:sequenceFlow id="Flow_11" name="Không (BHYT/cọc đủ)" sourceRef="GwConThu" targetRef="XepHang" />
    <bpmn:sequenceFlow id="Flow_12" name="Đã thu" sourceRef="ThuTU" targetRef="XepHang" />
    <bpmn:sequenceFlow id="Flow_13" name="" sourceRef="TimerTU" targetRef="HuyLuot" />
    <bpmn:sequenceFlow id="Flow_14" name="" sourceRef="HuyLuot" targetRef="EndHuy" />
    <bpmn:sequenceFlow id="Flow_15" name="" sourceRef="XepHang" targetRef="GoiKham" />
    <bpmn:sequenceFlow id="Flow_16" name="" sourceRef="GoiKham" targetRef="GwCoMat" />
    <bpmn:sequenceFlow id="Flow_17" name="Có" sourceRef="GwCoMat" targetRef="Kham" />
    <bpmn:sequenceFlow id="Flow_18" name="Không" sourceRef="GwCoMat" targetRef="QuaLuot" />
    <bpmn:sequenceFlow id="Flow_19" name="" sourceRef="QuaLuot" targetRef="GwLan3" />
    <bpmn:sequenceFlow id="Flow_20" name="Có" sourceRef="GwLan3" targetRef="EndVang" />
    <bpmn:sequenceFlow id="Flow_21" name="Không" sourceRef="GwLan3" targetRef="XepHang" />
    <bpmn:sequenceFlow id="Flow_22" name="" sourceRef="Kham" targetRef="GwCls" />
    <bpmn:sequenceFlow id="Flow_23" name="Có" sourceRef="GwCls" targetRef="Cls" />
    <bpmn:sequenceFlow id="Flow_24" name="Không" sourceRef="GwCls" targetRef="KetLuan" />
    <bpmn:sequenceFlow id="Flow_25" name="Có kết quả" sourceRef="Cls" targetRef="KetLuan" />
    <bpmn:sequenceFlow id="Flow_26" name="" sourceRef="KetLuan" targetRef="QuyetToan" />
    <bpmn:sequenceFlow id="Flow_27" name="" sourceRef="QuyetToan" targetRef="GwThuHoan" />
    <bpmn:sequenceFlow id="Flow_28" name="Thiếu" sourceRef="GwThuHoan" targetRef="ThuThem" />
    <bpmn:sequenceFlow id="Flow_29" name="Dư" sourceRef="GwThuHoan" targetRef="HoanDu" />
    <bpmn:sequenceFlow id="Flow_30" name="Vừa đủ" sourceRef="GwThuHoan" targetRef="GwGop" />
    <bpmn:sequenceFlow id="Flow_31" name="" sourceRef="ThuThem" targetRef="GwGop" />
    <bpmn:sequenceFlow id="Flow_32" name="" sourceRef="HoanDu" targetRef="GwGop" />
    <bpmn:sequenceFlow id="Flow_33" name="" sourceRef="GwGop" targetRef="GwThuoc" />
    <bpmn:sequenceFlow id="Flow_34" name="Có" sourceRef="GwThuoc" targetRef="CapThuoc" />
    <bpmn:sequenceFlow id="Flow_35" name="Không" sourceRef="GwThuoc" targetRef="End" />
    <bpmn:sequenceFlow id="Flow_36" name="" sourceRef="CapThuoc" targetRef="End" />
  </bpmn:process>
