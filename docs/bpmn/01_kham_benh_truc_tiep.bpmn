    <bpmn:sequenceFlow id="Flow_39" name="Có" sourceRef="GwThuoc" targetRef="CapThuoc" />
    <bpmn:sequenceFlow id="Flow_40" name="Không (mua ngoài / không có đơn)" sourceRef="GwThuoc" targetRef="End" />
    <bpmn:sequenceFlow id="Flow_41" name="" sourceRef="CapThuoc" targetRef="End" />
  </bpmn:process>
