      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndTuChoi_di" bpmnElement="EndTuChoi">
        <dc:Bounds x="1717" y="224.5" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1680" y="264.5" width="110" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GhiTK_di" bpmnElement="GhiTK">
        <dc:Bounds x="1850" y="67.5" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="HoanCoc_di" bpmnElement="HoanCoc">
        <dc:Bounds x="1850" y="472.5" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndHoan_di" bpmnElement="EndHoan">
        <dc:Bounds x="2097" y="494.5" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="2060" y="534.5" width="110" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndOk_di" bpmnElement="EndOk">
        <dc:Bounds x="2097" y="89.5" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="2060" y="129.5" width="110" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="215" y="126" />
        <di:waypoint x="215" y="203" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="290" y="243" />
        <di:waypoint x="380" y="243" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="405" y="218" />
        <di:waypoint x="405" y="126" />
        <bpmndi:BPMNLabel><dc:Bounds x="411" y="182" width="31" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
