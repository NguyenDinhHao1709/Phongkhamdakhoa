<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_DatLich" targetNamespace="http://phongkham.local/bpmn">
  <bpmn:collaboration id="Collab_DatLich">
    <bpmn:participant id="Pool_DatLich" name="Đặt lịch khám, đặt cọc và hủy lịch" processRef="Process_DatLich" />
  </bpmn:collaboration>
  <bpmn:process id="Process_DatLich" isExecutable="false">
    <bpmn:laneSet id="LaneSet_DatLich">
      <bpmn:lane id="Lane_BN" name="Bệnh nhân">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndHet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TraCoc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TimerTT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwHuy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw24</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GhiTK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndOk</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HT" name="Hệ thống">
        <bpmn:flowNodeRef>KtSlot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwSuat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GiuCho</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HuyTT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndHuyTT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>XacNhan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NhacLich</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndTuChoi</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PO" name="Cổng thanh toán PayOS">
        <bpmn:flowNodeRef>XuLyTT</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TN" name="Thu ngân / Lễ tân">
        <bpmn:flowNodeRef>HoanCoc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndHoan</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Chọn bác sĩ, ngày, khung giờ">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="KtSlot" name="Kiểm tra khung giờ trống &amp; suất tối đa mỗi buổi">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GwSuat" name="Còn suất?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndHet" name="Báo &quot;Đã kín&quot;, chọn giờ khác">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="GiuCho" name="Lập lịch hẹn &quot;chờ thanh toán&quot;, giữ chỗ 15 phút">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="TraCoc" name="Thanh toán tiền cọc (trực tuyến: 100% phí)">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="TimerTT" name="Hết 15 phút" attachedToRef="TraCoc" cancelActivity="true">
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_TimerTT"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">PT15M</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="HuyTT" name="Tự hủy lịch, nhả khung giờ">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndHuyTT" name="Lịch hẹn bị hủy">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="XuLyTT" name="Xử lý giao dịch, gửi webhook">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="XacNhan" name="Xác nhận lịch hẹn, lập hóa đơn cọc HDT">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="NhacLich" name="Gửi nhắc lịch trước giờ khám">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GwHuy" name="Bệnh nhân muốn hủy?">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw24" name="Còn đủ thời hạn hủy (cấu hình)?">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndTuChoi" name="Không hủy trực tuyến, không hoàn cọc">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="GhiTK" name="Hủy lịch, khai tài khoản nhận hoàn (cọc × % hoàn)">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="HoanCoc" name="Hoàn cọc theo yêu cầu &quot;chờ hoàn&quot;">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndHoan" name="Đã hoàn cọc">
      <bpmn:incoming>Flow_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndOk" name="Đến khám theo lịch (quy trình 01)">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" name="" sourceRef="Start" targetRef="KtSlot" />
    <bpmn:sequenceFlow id="Flow_2" name="" sourceRef="KtSlot" targetRef="GwSuat" />
    <bpmn:sequenceFlow id="Flow_3" name="Không" sourceRef="GwSuat" targetRef="EndHet" />
    <bpmn:sequenceFlow id="Flow_4" name="Có" sourceRef="GwSuat" targetRef="GiuCho" />
    <bpmn:sequenceFlow id="Flow_5" name="" sourceRef="GiuCho" targetRef="TraCoc" />
    <bpmn:sequenceFlow id="Flow_6" name="" sourceRef="TraCoc" targetRef="XuLyTT" />
    <bpmn:sequenceFlow id="Flow_7" name="Thành công" sourceRef="XuLyTT" targetRef="XacNhan" />
    <bpmn:sequenceFlow id="Flow_8" name="" sourceRef="TimerTT" targetRef="HuyTT" />
    <bpmn:sequenceFlow id="Flow_9" name="" sourceRef="HuyTT" targetRef="EndHuyTT" />
    <bpmn:sequenceFlow id="Flow_10" name="" sourceRef="XacNhan" targetRef="NhacLich" />
    <bpmn:sequenceFlow id="Flow_11" name="" sourceRef="NhacLich" targetRef="GwHuy" />
    <bpmn:sequenceFlow id="Flow_12" name="Có" sourceRef="GwHuy" targetRef="Gw24" />
    <bpmn:sequenceFlow id="Flow_13" name="Không" sourceRef="GwHuy" targetRef="EndOk" />
    <bpmn:sequenceFlow id="Flow_14" name="Có" sourceRef="Gw24" targetRef="GhiTK" />
    <bpmn:sequenceFlow id="Flow_15" name="Không" sourceRef="Gw24" targetRef="EndTuChoi" />
    <bpmn:sequenceFlow id="Flow_16" name="" sourceRef="GhiTK" targetRef="HoanCoc" />
    <bpmn:sequenceFlow id="Flow_17" name="" sourceRef="HoanCoc" targetRef="EndHoan" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_DatLich">
    <bpmndi:BPMNPlane id="Plane_DatLich" bpmnElement="Collab_DatLich">
      <bpmndi:BPMNShape id="Pool_DatLich_di" bpmnElement="Pool_DatLich" isHorizontal="true">
        <dc:Bounds x="60" y="40" width="2170" height="540" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_BN_di" bpmnElement="Lane_BN" isHorizontal="true">
        <dc:Bounds x="90" y="40" width="2140" height="135" />
