      <bpmndi:BPMNShape id="TimerDuyet_di" bpmnElement="TimerDuyet"><dc:Bounds x="2010" y="839.5" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2050" y="843.5" width="120" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="248" y="150" /><di:waypoint x="405" y="150" /><di:waypoint x="405" y="330" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="485" y="370" /><di:waypoint x="555" y="370" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="580" y="345" /><di:waypoint x="580" y="168" /><bpmndi:BPMNLabel><dc:Bounds x="586" y="172" width="120" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="605" y="370" /><di:waypoint x="675" y="370" /><bpmndi:BPMNLabel><dc:Bounds x="611" y="340" width="60" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="755" y="330" /><di:waypoint x="755" y="150" /><di:waypoint x="850" y="150" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="1010" y="150" /><di:waypoint x="1105" y="150" /><di:waypoint x="1105" y="507.5" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="978" y="208" /><di:waypoint x="978" y="330" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="930" y="410" /><di:waypoint x="930" y="529.5" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="1185" y="547.5" /><di:waypoint x="1280" y="547.5" /><di:waypoint x="1280" y="410" /><bpmndi:BPMNLabel><dc:Bounds x="1191" y="517.5" width="83" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="1360" y="370" /><di:waypoint x="1375" y="370" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="1535" y="370" /><di:waypoint x="1605" y="370" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12"><di:waypoint x="1630" y="345" /><di:waypoint x="1630" y="150" /><di:waypoint x="1780" y="150" /><bpmndi:BPMNLabel><dc:Bounds x="1636" y="154" width="120" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13"><di:waypoint x="1630" y="395" /><di:waypoint x="1630" y="682.5" /><di:waypoint x="1725" y="682.5" /><bpmndi:BPMNLabel><dc:Bounds x="1636" y="399" width="120" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
