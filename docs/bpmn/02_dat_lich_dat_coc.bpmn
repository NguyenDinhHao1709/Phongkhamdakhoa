        <di:waypoint x="430" y="243" />
        <di:waypoint x="520" y="243" />
        <bpmndi:BPMNLabel><dc:Bounds x="436" y="225" width="30" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="595" y="203" />
        <di:waypoint x="595" y="108" />
