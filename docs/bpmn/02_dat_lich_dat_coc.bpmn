      <bpmndi:BPMNShape id="EndHet_di" bpmnElement="EndHet"><dc:Bounds x="562" y="132" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="520" y="101" width="120" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GiuCho_di" bpmnElement="GiuCho"><dc:Bounds x="675" y="330" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TraCoc_di" bpmnElement="TraCoc"><dc:Bounds x="850" y="110" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="HuyTT_di" bpmnElement="HuyTT"><dc:Bounds x="850" y="330" width="160" height="80" /></bpmndi:BPMNShape>
