      <bpmndi:BPMNShape id="XuLyTT_di" bpmnElement="XuLyTT"><dc:Bounds x="1025" y="507.5" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="XacNhan_di" bpmnElement="XacNhan"><dc:Bounds x="1200" y="330" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NhacLich_di" bpmnElement="NhacLich"><dc:Bounds x="1375" y="330" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GwHuy_di" bpmnElement="GwHuy" isMarkerVisible="true"><dc:Bounds x="1605" y="345" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1483" y="314" width="120" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GwHan_di" bpmnElement="GwHan" isMarkerVisible="true"><dc:Bounds x="1780" y="125" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1745" y="94" width="120" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndTuChoi_di" bpmnElement="EndTuChoi"><dc:Bounds x="1787" y="187" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1745" y="227" width="120" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GhiTK_di" bpmnElement="GhiTK"><dc:Bounds x="1900" y="110" width="160" height="80" /></bpmndi:BPMNShape>
