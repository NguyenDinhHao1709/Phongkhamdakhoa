<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_DatLich" targetNamespace="http://phongkham.local/bpmn">
  <bpmn:collaboration id="Collab_DatLich">
    <bpmn:participant id="Pool_DatLich" name="Quy trình đặt lịch, đặt cọc, hủy lịch" processRef="Process_DatLich" />
  </bpmn:collaboration>
  <bpmn:process id="Process_DatLich" isExecutable="false">
    <bpmn:laneSet id="LaneSet_DatLich">
      <bpmn:lane id="Lane_BN" name="Bệnh nhân">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndHet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TraCoc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwHan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndTuChoi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GhiTK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TimerTT</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HT" name="Hệ thống">
        <bpmn:flowNodeRef>KtSlot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwSuat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GiuCho</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HuyTT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>XacNhan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NhacLich</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwHuy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwDen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndKhongDen</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PO" name="Cổng thanh toán PayOS">
        <bpmn:flowNodeRef>EndHuyTT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>XuLyTT</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BS" name="Bác sĩ">
        <bpmn:flowNodeRef>XinHuy</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GD" name="Ban giám đốc">
        <bpmn:flowNodeRef>DuyetHuy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TimerDuyet</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TN" name="Thu ngân">
        <bpmn:flowNodeRef>HoanCoc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndHoan</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Chọn bác sĩ, ngày, khung giờ">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="KtSlot" name="Kiểm tra khung giờ, khoảng ngày đặt trước, suất mỗi buổi">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GwSuat" name="Còn suất?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndHet" name="Báo &quot;Đã kín&quot;, chọn giờ khác">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="GiuCho" name="Lập lịch &quot;chờ thanh toán&quot;, giữ chỗ 15 phút">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="TraCoc" name="Thanh toán PayOS (trực tiếp: cọc theo cấu hình; trực tuyến: 100% phí)">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="HuyTT" name="Tự hủy lịch, nhả khung giờ">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndHuyTT" name="Lịch hẹn bị hủy">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="XuLyTT" name="Xử lý giao dịch, gửi webhook (đối soát mỗi 60 giây)">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="XacNhan" name="Xác nhận lịch, lập hóa đơn cọc HDT…">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="NhacLich" name="Email nhắc lịch hẹn trong 24 giờ tới">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GwHuy" name="Có yêu cầu hủy?">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GwHan" name="Còn đủ thời hạn hủy (cấu hình)?">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndTuChoi" name="Không hủy trực tuyến, không hoàn cọc">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="GhiTK" name="Hủy lịch, khai tài khoản nhận hoàn (cọc × % hoàn)">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="XinHuy" name="Gửi yêu cầu hủy ca (lịch → chờ duyệt hủy)">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="DuyetHuy" name="Duyệt yêu cầu hủy ca (từ chối → giữ lịch)">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GwDen" name="Đến check-in trong ngày hẹn?">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndOk" name="Đến khám (quy trình 01)">
      <bpmn:incoming>Flow_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndKhongDen" name="Hết ngày: hủy lịch, không hoàn cọc">
      <bpmn:incoming>Flow_22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="HoanCoc" name="Hoàn cọc theo yêu cầu &quot;chờ hoàn&quot;">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndHoan" name="Đã hoàn cọc">
      <bpmn:incoming>Flow_23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="TimerTT" name="Hết 15 phút" attachedToRef="TraCoc" cancelActivity="true">
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerTT_def" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="TimerDuyet" name="Chưa duyệt khi tới giờ hẹn → tự hủy" attachedToRef="DuyetHuy" cancelActivity="true">
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDuyet_def" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_1" name="" sourceRef="Start" targetRef="KtSlot" />
    <bpmn:sequenceFlow id="Flow_2" name="" sourceRef="KtSlot" targetRef="GwSuat" />
    <bpmn:sequenceFlow id="Flow_3" name="Không" sourceRef="GwSuat" targetRef="EndHet" />
    <bpmn:sequenceFlow id="Flow_4" name="Có" sourceRef="GwSuat" targetRef="GiuCho" />
    <bpmn:sequenceFlow id="Flow_5" name="" sourceRef="GiuCho" targetRef="TraCoc" />
    <bpmn:sequenceFlow id="Flow_6" name="" sourceRef="TraCoc" targetRef="XuLyTT" />
    <bpmn:sequenceFlow id="Flow_7" name="" sourceRef="TimerTT" targetRef="HuyTT" />
    <bpmn:sequenceFlow id="Flow_8" name="" sourceRef="HuyTT" targetRef="EndHuyTT" />
    <bpmn:sequenceFlow id="Flow_9" name="Thành công" sourceRef="XuLyTT" targetRef="XacNhan" />
    <bpmn:sequenceFlow id="Flow_10" name="" sourceRef="XacNhan" targetRef="NhacLich" />
    <bpmn:sequenceFlow id="Flow_11" name="" sourceRef="NhacLich" targetRef="GwHuy" />
    <bpmn:sequenceFlow id="Flow_12" name="Bệnh nhân hủy" sourceRef="GwHuy" targetRef="GwHan" />
    <bpmn:sequenceFlow id="Flow_13" name="Bác sĩ xin hủy" sourceRef="GwHuy" targetRef="XinHuy" />
    <bpmn:sequenceFlow id="Flow_14" name="Không" sourceRef="GwHuy" targetRef="GwDen" />
    <bpmn:sequenceFlow id="Flow_15" name="Có" sourceRef="GwHan" targetRef="GhiTK" />
    <bpmn:sequenceFlow id="Flow_16" name="Không" sourceRef="GwHan" targetRef="EndTuChoi" />
    <bpmn:sequenceFlow id="Flow_17" name="" sourceRef="GhiTK" targetRef="HoanCoc" />
    <bpmn:sequenceFlow id="Flow_18" name="" sourceRef="XinHuy" targetRef="DuyetHuy" />
    <bpmn:sequenceFlow id="Flow_19" name="Duyệt" sourceRef="DuyetHuy" targetRef="HoanCoc" />
    <bpmn:sequenceFlow id="Flow_20" name="" sourceRef="TimerDuyet" targetRef="HoanCoc" />
    <bpmn:sequenceFlow id="Flow_21" name="Có" sourceRef="GwDen" targetRef="EndOk" />
    <bpmn:sequenceFlow id="Flow_22" name="Không" sourceRef="GwDen" targetRef="EndKhongDen" />
    <bpmn:sequenceFlow id="Flow_23" name="" sourceRef="HoanCoc" targetRef="EndHoan" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_DatLich">
    <bpmndi:BPMNPlane id="Plane_DatLich" bpmnElement="Collab_DatLich">
      <bpmndi:BPMNShape id="Pool_DatLich_di" bpmnElement="Pool_DatLich" isHorizontal="true"><dc:Bounds x="90" y="40" width="2895" height="1065" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_BN_di" bpmnElement="Lane_BN" isHorizontal="true"><dc:Bounds x="120" y="40" width="2865" height="220" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_HT_di" bpmnElement="Lane_HT" isHorizontal="true"><dc:Bounds x="120" y="260" width="2865" height="220" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_PO_di" bpmnElement="Lane_PO" isHorizontal="true"><dc:Bounds x="120" y="480" width="2865" height="135" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_BS_di" bpmnElement="Lane_BS" isHorizontal="true"><dc:Bounds x="120" y="615" width="2865" height="135" /></bpmndi:BPMNShape>
