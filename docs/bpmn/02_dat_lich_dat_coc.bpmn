        <dc:Bounds x="1470" y="202.5" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GwHuy_di" bpmnElement="GwHuy" isMarkerVisible="true">
        <dc:Bounds x="1520" y="82.5" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1410" y="94.5" width="110" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
