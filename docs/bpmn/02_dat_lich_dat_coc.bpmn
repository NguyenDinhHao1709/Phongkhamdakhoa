      <bpmndi:BPMNShape id="DuyetHuy_di" bpmnElement="DuyetHuy"><dc:Bounds x="1900" y="777.5" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GwDen_di" bpmnElement="GwDen" isMarkerVisible="true"><dc:Bounds x="2305" y="345" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="2270" y="314" width="120" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndOk_di" bpmnElement="EndOk"><dc:Bounds x="2487" y="352" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2445" y="392" width="120" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndKhongDen_di" bpmnElement="EndKhongDen"><dc:Bounds x="2312" y="407" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2188" y="412" width="120" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="HoanCoc_di" bpmnElement="HoanCoc"><dc:Bounds x="2600" y="900" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndHoan_di" bpmnElement="EndHoan"><dc:Bounds x="2837" y="922" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2795" y="962" width="120" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
