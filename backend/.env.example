NODE_ENV=development
PORT=5000

# Database MySQL (schema v2 - phong_kham)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=phong_kham

# JWT
JWT_SECRET=phongkham_jwt_super_secret_2026_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=phongkham_refresh_secret_2026_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# Email (OTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password_here
MAIL_FROM=Phong Kham Da Khoa <no-reply@phongkham.vn>
OTP_EXPIRES_MINUTES=10

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Frontend URL (CORS)
CLIENT_URL=http://localhost:3000
# Domain Zalo Mini App được cho phép gọi API mặc định (https://h5.zdn.vn, https://h5.zadn.vn); đổi ở đây nếu cần
# ZALO_MINI_APP_ORIGINS=https://h5.zdn.vn,https://h5.zadn.vn

# Zalo Mini App: secret key của app tại developers.zalo.me (dùng giải mã số điện thoại khi đăng nhập Zalo)
ZALO_APP_SECRET=
ZALO_APP_ID=

# Zalo ZNS (gửi nhắc lịch / xác nhận lịch / có kết quả tới số điện thoại bệnh nhân)
# Refresh token OA ban đầu (sau đó hệ thống tự xoay vòng và lưu ở bảng zalo_oa_token)
ZALO_OA_REFRESH_TOKEN=
# development = chỉ gửi tới số quản trị viên OA, không tính phí (demo); để trống khi chạy thật
ZNS_MODE=development
# ID mẫu tin đã được Zalo duyệt; để trống loại nào thì loại đó không gửi Zalo
ZNS_TEMPLATE_NHAC_LICH=
ZNS_TEMPLATE_XAC_NHAN_LICH=
ZNS_TEMPLATE_CO_KET_QUA=

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# Internal services
# Production: https://phongkham-ai.onrender.com
AI_SERVICE_URL=http://localhost:5002
OFFICE_SERVICE_URL=http://localhost:5003
PYTHON_ML_URL=http://localhost:5001
# Số ngày giữ ảnh chấm công (dữ liệu sinh trắc) trước khi tự xóa; bỏ trống hoặc 0 = giữ vô thời hạn
CHAM_CONG_SO_NGAY_LUU_ANH=
# python-ml cũng kiểm tra AI_INTERNAL_KEY (header x-internal-key) — đặt cùng giá trị ở cả 3 service
