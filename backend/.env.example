NODE_ENV=development
PORT=5000

# Database MySQL (schema v2 - phong_kham)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=phong_kham

# JWT
JWT_SECRET=phongkham_jwt_super_secret_2026_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=phongkham_refresh_secret_2026_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# Email (OTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password_here
MAIL_FROM=Phong Kham Da Khoa <no-reply@phongkham.vn>
OTP_EXPIRES_MINUTES=10

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Frontend URL (CORS)
CLIENT_URL=http://localhost:3000

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# Internal services
# Production: https://phongkham-ai.onrender.com
AI_SERVICE_URL=http://localhost:5002
OFFICE_SERVICE_URL=http://localhost:5003
PYTHON_ML_URL=http://localhost:5001
# python-ml cũng kiểm tra AI_INTERNAL_KEY (header x-internal-key) — đặt cùng giá trị ở cả 3 service
